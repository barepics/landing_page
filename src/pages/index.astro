---
import apkInfo from "../apk-info.json" with { type: "json" };
import Layout from '../layouts/Layout.astro';
import {Image} from "astro:assets";

import barepicsCategories from "../assets/images/barepics_categories.jpg";
import barepicsGalleries from "../assets/images/barepics_galleries.jpg";

---

<Layout title="Barepics - The Ultimate Premium Gallery">
		<header
			class="max-w-6xl mx-auto px-4 py-20 flex flex-col md:flex-row items-center justify-between min-h-[85vh]"
		>
			<div class="md:w-1/2 text-center md:text-left mb-12 md:mb-0">
				<h1 class="text-5xl md:text-7xl font-black leading-tight mb-6">
					Premium Content, <br />
					<span class="text-transparent bg-clip-text bg-linear-to-r from-brand to-rose-400"
						>Zero Limits.</span
					>
				</h1>
				<p id="before-download" class="text-xl text-gray-400 mb-10 max-w-lg mx-auto md:mx-0">
					Dive into an infinite feed of high-quality galleries and exclusive channels. Uncensored,
					fast, and built perfectly for your Android device.
				</p>
				<div class="flex flex-col sm:flex-row items-center gap-4" id="download">
					<a
						id="main-download-btn" 
						href="https://apks.lazaroosee.xyz/barepics/app-release.apk"
						download="barepics-apk.apk"
						class="w-full sm:w-auto px-8 py-4 text-lg font-bold rounded-full bg-brand hover:bg-rose-700 transition flex items-center justify-center gap-3 shadow-[0_0_20px_rgba(225,29,72,0.4)]"
					>
						<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
							<path
								d="M17.593 3.322c-.386-.296-.921-.296-1.307 0l-3.286 2.52c-.672.515-1.328.515-2 0l-3.286-2.52c-.386-.296-.921-.296-1.307 0-.386.296-.386.776 0 1.072l3.286 2.52c1.058.811 2.556.811 3.614 0l3.286-2.52c.386-.296.386-.776 0-1.072zM12 11c-3.859 0-7 3.141-7 7s3.141 7 7 7 7-3.141 7-7-3.141-7-7-7zm0 12c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5zm1-8h-2v2h2v-2zm0-4h-2v2h2v-2z"
							/>
						</svg>
						Download APK
					</a>
					<p class="text-sm text-gray-500">Version {apkInfo.version} • Android {apkInfo.supportedDevices.android}+</p>
				</div>
			</div>

			<div class="preview md:w-1/2 flex justify-center relative">
				<div
					class="absolute w-64 h-64 bg-brand rounded-full blur-[100px] opacity-20 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
				></div>
				<div
					class="w-72 h-150 bg-dark border-8 border-gray-800 rounded-[2.5rem] relative overflow-hidden shadow-2xl z-10 flex items-center justify-center aspect-9/16"
				>
					<Image src={barepicsCategories} alt="Barepics Categories" class="aspect-auto"  />
				</div>
			</div>

			<div class="preview hidden md:w-1/2 justify-center relative">
				<div
					class="absolute w-64 h-64 bg-brand rounded-full blur-[100px] opacity-20 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
				></div>
				<div
					class="w-72 h-150 bg-dark border-8 border-gray-800 rounded-[2.5rem] relative overflow-hidden shadow-2xl z-10 flex items-center justify-center aspect-9/16"
				>
					<Image src={barepicsGalleries} alt="Barepics Galleries" class="aspect-auto"  />
				</div>
			</div>
		</header>

		<section class="bg-dark py-20 border-t border-gray-800">
			<div class="max-w-6xl mx-auto px-4">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-5xl font-bold mb-4">Why Barepics?</h2>
					<p class="text-gray-400 text-lg">
						Built outside the app store to give you exactly what you want.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div
						class="bg-darker p-8 rounded-2xl border border-gray-800 hover:border-brand transition duration-300"
					>
						<div
							class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6 text-brand text-2xl"
						>
							⚡
						</div>
						<h3 class="text-xl font-bold mb-3">Lightning Fast</h3>
						<p class="text-gray-400">
							Infinite scrolling feeds optimized for speed. No waiting, just seamless browsing.
						</p>
					</div>
					<div
						class="bg-darker p-8 rounded-2xl border border-gray-800 hover:border-brand transition duration-300"
					>
						<div
							class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6 text-brand text-2xl"
						>
							🔒
						</div>
						<h3 class="text-xl font-bold mb-3">100% Private</h3>
						<p class="text-gray-400">
							No official app store tracking. What you browse stays on your device.
						</p>
					</div>
					<div
						class="bg-darker p-8 rounded-2xl border border-gray-800 hover:border-brand transition duration-300"
					>
						<div
							class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6 text-brand text-2xl"
						>
							💎
						</div>
						<h3 class="text-xl font-bold mb-3">Curated Channels</h3>
						<p class="text-gray-400">
							Explore specific tags, stars, and exclusive channels tailored to your exact tastes.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="py-20">
			<div class="max-w-3xl mx-auto px-4 text-center">
				<h2 class="text-3xl font-bold mb-8">How to Install</h2>
				<div class="bg-dark border border-gray-800 rounded-2xl p-8 text-left">
					<ol class="list-decimal list-inside text-gray-300 space-y-4 text-lg">
						<li>Tap the <strong>Download APK</strong> button above.</li>
						<li>Once downloaded, open the file from your notifications or Downloads folder.</li>
						<li>
							If prompted, go to Settings and toggle <strong>"Allow from this source"</strong>.
						</li>
						<li>Tap Install, open the app, and enjoy!</li>
					</ol>
				</div>
			</div>
		</section>
</Layout>


<script>
	import { track } from '@vercel/analytics';
 
	const previews = document.querySelectorAll('.preview');

	function togglePreviews() {
		previews.forEach(preview => {
			preview.classList.toggle('hidden');
			preview.classList.toggle('flex');
		});
	}

	async function setOptimizedDownloadLink() {
		const downloadBtn = document.getElementById('main-download-btn') as HTMLAnchorElement;
		// Default to the universal APK
		let apkPath = "https://apks.lazaroosee.xyz/barepics/app-release.apk";

		// @ts-ignore
		if (navigator.userAgentData) {
			try {
			// @ts-ignore
			const hints = await navigator.userAgentData.getHighEntropyValues(['architecture', 'bitness']);

			// alert(JSON.stringify(hints, null, 2))

			if(hints.mobile) {
				if (hints.platform.toLowerCase() === 'android') {
					apkPath = "https://apks.lazaroosee.xyz/barepics/app-arm64-v8a-release.apk";
				}  else {
					apkPath = "https://apks.lazaroosee.xyz/barepics/app-armeabi-v7a-release.apk";
				}
			}
			
			if (hints.architecture === 'arm') {
				if (hints.bitness === '64') {
					apkPath = "https://apks.lazaroosee.xyz/barepics/app-arm64-v8a-release.apk";
				} else {
					apkPath = "https://apks.lazaroosee.xyz/barepics/app-armeabi-v7a-release.apk";
				}
			} else if (hints.architecture === 'x86' && hints.bitness === '64') {
				apkPath = "https://apks.lazaroosee.xyz/barepics/app-x86_64-release.apk";
			}
			} catch (error) {
				console.log("Could not detect architecture, defaulting to universal.");
			}
		}

		// Update the button's href to the correct path
		downloadBtn.href = apkPath;
		downloadBtn.download = "barepics-apk.apk";
		downloadBtn.addEventListener('click', () => {
			track('DownloadEvent', {apkPath}, { flags: ['summer-sale'] });
		});
	}

	// Run when the DOM is ready
	document.addEventListener('DOMContentLoaded', setOptimizedDownloadLink);

	// Toggle previews every 6 seconds
	setInterval(togglePreviews, 6000);
</script>

