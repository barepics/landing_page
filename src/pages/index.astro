---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Barepics - The Ultimate Premium Gallery</title>
		<meta name="exoclick-site-verification" content="YOUR_VERIFICATION_CODE_HERE" />

		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							brand: '#E11D48', // A sleek neon rose/red accent
							dark: '#0f172a',
							darker: '#020617',
						},
					},
				},
			}
		</script>
		<style>
			body {
				font-family:
					-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
			}
			/* Smooth scrolling */
			html {
				scroll-behavior: smooth;
			}
			/* Modal Blur */
			.modal-blur {
				-webkit-backdrop-filter: blur(10px);
				backdrop-filter: blur(10px);
			}
		</style>
	</head>
	<body class="bg-darker text-white antialiased overflow-hidden" id="body">
		<div
			id="age-modal"
			class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 modal-blur transition-opacity duration-300"
		>
			<div
				class="bg-dark p-8 rounded-2xl max-w-md w-[90%] text-center border border-gray-800 shadow-2xl"
			>
				<h2 class="text-3xl font-bold text-brand mb-4">18+ Only</h2>
				<p class="text-gray-400 mb-8">
					This application contains adult content. You must be at least 18 years old to enter and
					download.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<button
						onclick="leaveSite()"
						class="px-6 py-3 rounded-lg font-semibold bg-gray-800 text-gray-300 hover:bg-gray-700 transition"
					>
						I am under 18
					</button>
					<button
						onclick="enterSite()"
						class="px-6 py-3 rounded-lg font-semibold bg-brand text-white hover:bg-rose-700 transition shadow-[0_0_15px_rgba(225,29,72,0.5)]"
					>
						I am 18 or older
					</button>
				</div>
			</div>
		</div>

		<nav class="w-full border-b border-gray-800 bg-darker/80 backdrop-blur-md sticky top-0 z-40">
			<div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
				<div class="text-2xl font-black tracking-tighter text-white">
					BARE<span class="text-brand">PICS</span>
				</div>
				<a
					href="#download"
					class="px-5 py-2 text-sm font-bold rounded-full bg-brand hover:bg-rose-700 transition"
					>Get App</a
				>
			</div>
		</nav>

		<header
			class="max-w-6xl mx-auto px-4 py-20 flex flex-col md:flex-row items-center justify-between min-h-[85vh]"
		>
			<div class="md:w-1/2 text-center md:text-left mb-12 md:mb-0">
				<h1 class="text-5xl md:text-7xl font-black leading-tight mb-6">
					Premium Content, <br />
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-rose-400"
						>Zero Limits.</span
					>
				</h1>
				<p class="text-xl text-gray-400 mb-10 max-w-lg mx-auto md:mx-0">
					Dive into an infinite feed of high-quality galleries and exclusive channels. Uncensored,
					fast, and built perfectly for your Android device.
				</p>
				<div class="flex flex-col sm:flex-row items-center gap-4" id="download">
					<a
						href="#"
						download
						class="w-full sm:w-auto px-8 py-4 text-lg font-bold rounded-full bg-brand hover:bg-rose-700 transition flex items-center justify-center gap-3 shadow-[0_0_20px_rgba(225,29,72,0.4)]"
					>
						<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
							<path
								d="M17.593 3.322c-.386-.296-.921-.296-1.307 0l-3.286 2.52c-.672.515-1.328.515-2 0l-3.286-2.52c-.386-.296-.921-.296-1.307 0-.386.296-.386.776 0 1.072l3.286 2.52c1.058.811 2.556.811 3.614 0l3.286-2.52c.386-.296.386-.776 0-1.072zM12 11c-3.859 0-7 3.141-7 7s3.141 7 7 7 7-3.141 7-7-3.141-7-7-7zm0 12c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5zm1-8h-2v2h2v-2zm0-4h-2v2h2v-2z"
							/>
						</svg>
						Download APK
					</a>
					<p class="text-sm text-gray-500">Version 1.0.0 • Android 8.0+</p>
				</div>
			</div>

			<div class="md:w-1/2 flex justify-center relative">
				<div
					class="absolute w-64 h-64 bg-brand rounded-full blur-[100px] opacity-20 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
				></div>
				<div
					class="w-72 h-[600px] bg-dark border-[8px] border-gray-800 rounded-[2.5rem] relative overflow-hidden shadow-2xl z-10 flex items-center justify-center"
				>
					<p class="text-gray-600 font-bold rotate-[-45deg] opacity-50 text-2xl">APP SCREENSHOT</p>
				</div>
			</div>
		</header>

		<section class="bg-dark py-20 border-t border-gray-800">
			<div class="max-w-6xl mx-auto px-4">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-5xl font-bold mb-4">Why Barepics?</h2>
					<p class="text-gray-400 text-lg">
						Built outside the app store to give you exactly what you want.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div
						class="bg-darker p-8 rounded-2xl border border-gray-800 hover:border-brand transition duration-300"
					>
						<div
							class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6 text-brand text-2xl"
						>
							⚡
						</div>
						<h3 class="text-xl font-bold mb-3">Lightning Fast</h3>
						<p class="text-gray-400">
							Infinite scrolling feeds optimized for speed. No waiting, just seamless browsing.
						</p>
					</div>
					<div
						class="bg-darker p-8 rounded-2xl border border-gray-800 hover:border-brand transition duration-300"
					>
						<div
							class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6 text-brand text-2xl"
						>
							🔒
						</div>
						<h3 class="text-xl font-bold mb-3">100% Private</h3>
						<p class="text-gray-400">
							No official app store tracking. What you browse stays on your device.
						</p>
					</div>
					<div
						class="bg-darker p-8 rounded-2xl border border-gray-800 hover:border-brand transition duration-300"
					>
						<div
							class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6 text-brand text-2xl"
						>
							💎
						</div>
						<h3 class="text-xl font-bold mb-3">Curated Channels</h3>
						<p class="text-gray-400">
							Explore specific tags, stars, and exclusive channels tailored to your exact tastes.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="py-20">
			<div class="max-w-3xl mx-auto px-4 text-center">
				<h2 class="text-3xl font-bold mb-8">How to Install</h2>
				<div class="bg-dark border border-gray-800 rounded-2xl p-8 text-left">
					<ol class="list-decimal list-inside text-gray-300 space-y-4 text-lg">
						<li>Tap the <strong>Download APK</strong> button above.</li>
						<li>Once downloaded, open the file from your notifications or Downloads folder.</li>
						<li>
							If prompted, go to Settings and toggle <strong>"Allow from this source"</strong>.
						</li>
						<li>Tap Install, open the app, and enjoy!</li>
					</ol>
				</div>
			</div>
		</section>

		<footer class="bg-darker py-10 border-t border-gray-800 text-center text-gray-500">
			<div class="space-x-4 mb-4">
				<a href="terms.html" class="hover:text-brand transition">Terms of Service</a>
				<a href="privacy.html" class="hover:text-brand transition">Privacy Policy</a>
			</div>
			<p class="mb-2">&copy; <span id="year">2024</span> Barepics. All rights reserved.</p>
			<p class="text-sm">
				By downloading the app or using this site, you agree to our Terms of Service and Privacy
				Policy.
			</p>
		</footer>

		<script id="copyright-script">
			const yearElement = document.getElementById('year')
			if (yearElement) {
				yearElement.textContent = new Date().getFullYear()
			}
		</script>

		<script>
			// Check if user already verified age
			window.onload = function () {
				if (localStorage.getItem('ageVerified') === 'true') {
					document.getElementById('age-modal').style.display = 'none'
					document.getElementById('body').classList.remove('overflow-hidden')
				}
			}

			function enterSite() {
				localStorage.setItem('ageVerified', 'true')
				const modal = document.getElementById('age-modal')
				modal.style.opacity = '0'
				setTimeout(() => {
					modal.style.display = 'none'
					document.getElementById('body').classList.remove('overflow-hidden')
				}, 300) // Wait for fade out
			}

			function leaveSite() {
				window.location.href = 'https://www.google.com'
			}
		</script>
	</body>
</html>
</Layout>
